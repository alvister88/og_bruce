<mujoco model="og_bruce scene">

  <include file="og_bruce.xml"/>
  
  <!-- Define explicit contacts with the scene -->
  <contact>
    <!-- Floot collision with height field -->
    <pair geom1="foot_contact_r" geom2="hfield"/>
    <pair geom1="foot_contact_l" geom2="hfield"/>

  </contact>


  <statistic center="0 0 1.0" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.2 0.2 0.2 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.1 0.1 0.1" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker"
            rgb1="0.2 0.2 0.2" rgb2="0.05 0.05 0.05" 
            mark="edge" markrgb="0.6 0.6 0.6"
            width="300" height="300"/>
    <material name="groundplane" texture="groundplane"
              texuniform="true" texrepeat="5 5" reflectance="0.05"/>
     <hfield name="hfield" file="hfields/hfield_256.png" size="20 20 .02 0.1"/> 
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- Height Field Geom -->
    <geom name="hfield" type="hfield" hfield="hfield" material="groundplane" contype="0" conaffinity="0" />
    <!-- Stationary camera wrt to world -->
    <camera name="side_view" pos="0.846 -1.465 0.916" xyaxes="0.866 0.500 0.000 -0.171 0.296 0.940"/>
  </worldbody>
</mujoco>