                        </body>
                        <body name="knee_pitch_r0" pos="0.174817 0 -0.0075" quat="0.707107 0.707107 0 0">
                            <inertial pos="0.0 0.0 0.0" mass="0.0001"
                                      diaginertia="4.04275e-08 3.80418e-08 7.70463e-08"/>
                            <joint name="knee_pitch_r0" pos="0 0 0" axis="0 0 1"/>
                            <body name="ankle_pitch_r1" pos="0 -0.03  0" quat="0.9886517   0  0 0.1502256">
                                <joint name="ankle_pitch_r10" pos="0 0 0" axis="0 0 1"/>
