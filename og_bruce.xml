<mujoco model="BRUCE_OG_SIMPLE_urdf">
    <compiler angle="radian" autolimits="true"/>

    <option impratio="5" iterations="3" ls_iterations="1" integrator="implicitfast" timestep="0.0025">
            <flag gravity="enable"/>
    </option>
    <!-- <flag gravity="disable"/> -->

    <default>
        <default class="og_bruce">
            <geom contype="0" conaffinity="0" type="mesh" group="2"/>
            <joint damping="1.0" armature="0.011"/>
            <position ctrlrange="-3.14 3.14" kp="1000" kv="5" />

            <default class="og_bruce/collision">
                <!-- Group right now is arbitrary -->
                <geom group="1" contype="0" conaffinity="1"/>
                <default class="og_bruce/collision/foot">
                    <geom rgba="0.79216 0.81961 0.93333 0.4" solimp="0.015 1 0.031" friction="1.5 0.02 0.01"/>
                </default>
            </default>

            <default class="og_bruce/affine_bear">
              <position forcerange="-6.0 6.0"/>
            </default>

            <default class="og_bruce/affine_dynamixel">
              <position forcerange="-0.5 0.5" />
            </default>
        </default>
    </default>

    <asset>
        <mesh name="base_link" file="og_bruce_meshes/base_link.STL"/>
        <mesh name="hip_yaw_r" file="og_bruce_meshes/hip_yaw_r.STL"/>
        <mesh name="hip_pitch_r" file="og_bruce_meshes/hip_pitch_r.STL"/>
        <mesh name="hip_roll_r" file="og_bruce_meshes/hip_roll_r.STL"/>
        <mesh name="knee_pitch_r" file="og_bruce_meshes/knee_pitch_r.STL"/>
        <mesh name="ankle_pitch_r" file="og_bruce_meshes/ankle_pitch_r.STL"/>
        <mesh name="hip_yaw_l" file="og_bruce_meshes/hip_yaw_l.STL"/>
        <mesh name="hip_pitch_l" file="og_bruce_meshes/hip_pitch_l.STL"/>
        <mesh name="hip_roll_l" file="og_bruce_meshes/hip_roll_l.STL"/>
        <mesh name="knee_pitch_l" file="og_bruce_meshes/knee_pitch_l.STL"/>
        <mesh name="ankle_pitch_l" file="og_bruce_meshes/ankle_pitch_l.STL"/>
        <mesh name="ankle_motor_link" file="og_bruce_meshes/ankle_motor_link.STL"/>
        <mesh name="ankle_motor_rod" file="og_bruce_meshes/ankle_motor_rod.STL"/>
        <mesh name="shoulder_pitch_r" file="og_bruce_meshes/shoulder_pitch_r.STL"/>
        <mesh name="shoulder_roll_r" file="og_bruce_meshes/shoulder_roll_r.STL"/>
        <mesh name="elbow_pitch_r" file="og_bruce_meshes/elbow_pitch_r.STL"/>
        <mesh name="shoulder_pitch_l" file="og_bruce_meshes/shoulder_pitch_l.STL"/>
        <mesh name="shoulder_roll_l" file="og_bruce_meshes/shoulder_roll_l.STL"/>
        <mesh name="elbow_pitch_l" file="og_bruce_meshes/elbow_pitch_l.STL"/>
    </asset>

    <worldbody>
        <!-- base link z at 0.5m to start in scene -->
        <body name="base_link" pos="0.0 0.0 0.0" quat="1.0 0.0 0.0 0.0" childclass="og_bruce">
            <!-- So the model isn't rigid in the air -->
            <freejoint /> 
            <!-- Camera wrt to COM to track the base link -->
            <camera name="track_com" pos="1.566 -1.878 0.473" xyaxes="0.768 0.641 0.000 -0.101 0.122 0.987" mode="trackcom"/>

            <geom type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="base_link"/>
            <inertial pos="0.02325 -0.00013 0.07844" mass="1.52819" diaginertia="0.010858132 0.00685942 0.005914725"/>

            <body name="hip_yaw_r" pos="0.029801 -0.0758555 -0.0384375" quat="0.707107 0 0 -0.707107">
