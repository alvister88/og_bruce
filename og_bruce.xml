                                <inertial pos="0.014913 0.0053931 0.00011234"
                                          quat="0.468881 0.503427 -0.499007 0.526977" mass="0.025"
                                          diaginertia="2.1159e-05 2.02708e-05 1.57584e-06"/>
                                <joint name="ankle_pitch_r" pos="0 0 0" axis="0 0 -1" range="-1.2566 1.0472"/>
                                <geom type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="ankle_pitch_r"/>
                                <site name="ankle_attachment_r" pos="0 -0.03 0"/>
                                
                                <!-- Contact geometry for right foot -->
                                <body>
                                    <geom class="og_bruce/collision/foot" name="foot_contact_r" type="box" size="0.0125 0.05 0.007" pos="0.011 0.008 0"/>
                                </body>
                                <site name="footR_contact_site_front" pos="0.023 0.05 0" size="0.007" rgba="1 0 0 0.5"/>
