                                  mass="0.76925" diaginertia="0.00303236 0.00284069 0.000427703"/>
                        <joint name="hip_roll_r" pos="0 0 0" axis="0 0 1" range="-0.95993 0.95993"/>
                        <geom type="mesh" rgba="0.79216 0.81961 0.93333 1" mesh="hip_roll_r"/>

                        <body name="knee_pitch_r" pos="0.174817 0 -0.0075" quat="0.707107 0.707107 0 0">
                            <inertial pos="0.049407 0.03979 0.00043596" quat="-0.0540474 0.685679 -0.166088 0.706639"
