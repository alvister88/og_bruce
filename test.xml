<mujoco model="test_STL's">
  <!-- Compiler options -->
  <compiler angle="radian"/>

  <!-- Default settings -->
  <default>
    <joint damping="1"/>
    <geom type="mesh" contype="1" conaffinity="1" condim="3" friction="1 0.5 0.5"
          solimp="0.9 0.95 0.001" solref="0.02 1"/>
  </default>

  <!-- Option settings -->
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" integrator="RK4"/>

  <!-- Asset definitions -->
  <asset>
    <!-- Define the mesh for shoulder_roll_r -->
    <mesh name="shoulder_roll_r_mesh" file="../../urdf/BRUCE_OG_urdf/meshes/elbow_pitch_r.STL"/>
  </asset>

  <!-- World body -->
  <worldbody>
    <body name="shoulder_roll_r_body" pos="0 0 0">
      <!-- Geometry using the mesh -->
      <geom name="shoulder_roll_r_geom" mesh="shoulder_roll_r_mesh"/>
    </body>
  </worldbody>
</mujoco>
